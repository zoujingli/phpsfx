# shellcheck shell=bash disable=SC2034
# Swoole CLI SFX slim 裁剪配置。
# 该文件只使用“默认赋值”，调用方仍可通过环境变量显式覆盖任一项。

: "${PHPSFX_PROFILE_NAME:=hyperfadmin-slim}"
: "${PHPSFX_PHP_VERSION:=8.5}"
: "${PHPSFX_PHP_FULL_VERSION:=8.5.9}"
: "${PHPSFX_SWOOLE_CLI_REF:=f7903840c3e959612dac7d413205e1bdb0067029}"
: "${PHPSFX_SWOOLE_SRC_REF:=v6.2.3}"
: "${PHPSFX_RELEASE_VERSION:=v6.2.3.2}"
: "${PHPSFX_DB_VARIANT:=mysql-pgsql-sqlite}"

case "${PHPSFX_DB_VARIANT}" in
  sqlite)
    db_pdo_extensions=pdo_sqlite
    db_pdo_drivers=sqlite
    db_pdo_flags='-pdo_mysql -pdo_pgsql +pdo_sqlite'
    db_forbidden_extensions=pdo_mysql,pdo_pgsql
    ;;
  mysql)
    db_pdo_extensions=pdo_mysql
    db_pdo_drivers=mysql
    db_pdo_flags='+pdo_mysql -pdo_pgsql -pdo_sqlite'
    db_forbidden_extensions=pdo_pgsql,pdo_sqlite
    ;;
  pgsql)
    db_pdo_extensions=pdo_pgsql
    db_pdo_drivers=pgsql
    db_pdo_flags='-pdo_mysql +pdo_pgsql -pdo_sqlite'
    db_forbidden_extensions=pdo_mysql,pdo_sqlite
    ;;
  mysql-pgsql)
    db_pdo_extensions=pdo_mysql,pdo_pgsql
    db_pdo_drivers=mysql,pgsql
    db_pdo_flags='+pdo_mysql +pdo_pgsql -pdo_sqlite'
    db_forbidden_extensions=pdo_sqlite
    ;;
  pgsql-sqlite)
    db_pdo_extensions=pdo_pgsql,pdo_sqlite
    db_pdo_drivers=pgsql,sqlite
    db_pdo_flags='+pdo_pgsql +pdo_sqlite -pdo_mysql'
    db_forbidden_extensions=pdo_mysql
    ;;
  mysql-sqlite)
    db_pdo_extensions=pdo_mysql,pdo_sqlite
    db_pdo_drivers=mysql,sqlite
    db_pdo_flags='+pdo_mysql +pdo_sqlite -pdo_pgsql'
    db_forbidden_extensions=pdo_pgsql
    ;;
  mysql-pgsql-sqlite)
    db_pdo_extensions=pdo_mysql,pdo_pgsql,pdo_sqlite
    db_pdo_drivers=mysql,pgsql,sqlite
    db_pdo_flags='+pdo_mysql +pdo_pgsql +pdo_sqlite'
    db_forbidden_extensions=
    ;;
  *)
    echo "Unsupported PHPSFX_DB_VARIANT: ${PHPSFX_DB_VARIANT}" >&2
    return 2
    ;;
esac
: "${PHPSFX_ASSET_SUFFIX:=${PHPSFX_DB_VARIANT}}"

# 仅保留 SFX、Swoole 服务、Phar 发布、数据库、基础网络、图片处理、二维码压缩和 OPcache 常用扩展。
: "${PHPSFX_EXTENSIONS:=bcmath,bz2,ctype,curl,dom,fileinfo,filter,gd,iconv,mbstring,opcache,openssl,pcntl,${db_pdo_extensions},phar,posix,redis,simplexml,sockets,sodium,swoole,tokenizer,xml,xmlreader,xmlwriter,zip,zlib}"

# 构建后必须加载的扩展；json/hash/pcre/reflection/PDO/libxml 等由 PHP core 或依赖扩展带出，不作为 prepare.php 显式项。
: "${PHPSFX_REQUIRED_EXTENSIONS:=swoole,redis,${db_pdo_extensions},openssl,curl,mbstring,phar,zlib,zip,dom,simplexml,xmlreader,xmlwriter,fileinfo,bcmath,bz2,gd,opcache,sodium,sockets}"
: "${PHPSFX_REQUIRED_PDO_DRIVERS:=${db_pdo_drivers}}"

# 明确排除未使用或体积较大的扩展，防止官方 full runtime 被误发布为 slim 产物；bz2/gd/opcache 是 dmskc 标准能力，不在禁用列表。
: "${PHPSFX_FORBIDDEN_EXTENSIONS:=exif,gettext,gmp,imagick,intl,mongodb,mysqli,pgsql,readline,session,soap,sqlite3,xlswriter,xsl,yaml${db_forbidden_extensions:+,${db_forbidden_extensions}}}"

# Swoole CLI 官方 prepare.php 裁剪参数。+xml 会同时提供 dom/simplexml/xmlreader/xmlwriter 能力。
: "${PHPSFX_SWOOLE_CLI_PREPARE_FLAGS:=+bcmath +bz2 +ctype +curl +fileinfo +filter +gd +iconv +mbstring +opcache +openssl +pcntl ${db_pdo_flags} +phar +posix +redis +sockets +sodium +swoole +tokenizer +xml +zip +zlib -exif -gettext -gmp -imagick -intl -mongodb -mysqli -pgsql -readline -session -soap -sqlite3 -xlswriter -xsl -yaml}"

# 直接收敛 Swoole CLI 默认启用列表，避免默认 full profile 在 prepare 阶段下载和编译未使用扩展。
: "${PHPSFX_SWOOLE_CLI_ENABLED_EXTENSIONS:=bcmath,bz2,ctype,curl,fileinfo,filter,gd,iconv,mbstring,opcache,openssl,pcntl,${db_pdo_extensions},phar,posix,redis,sockets,sodium,swoole,tokenizer,xml,zip,zlib}"

# 裁剪 Swoole 扩展自身的可选能力：保留 server/coroutine/curl/mysqlnd/DNS 能力；
# PostgreSQL and SQLite are available through PDO only. Keep native pgsql,
# SQLite3, Swoole SQLite hooks, and unrelated optional features disabled.
: "${PHPSFX_SWOOLE_SLIM_EXTENSION:=1}"

# 裁剪 curl/libzip 依赖库：保留 HTTP(S)、zlib、OpenSSL、c-ares，移除 HTTP3/SSH2/IDN/PSL/Brotli/Zstd/LZMA/BZip2 等非必需能力。
: "${PHPSFX_CURL_SLIM_LIBRARY:=1}"
: "${PHPSFX_LIBZIP_SLIM_LIBRARY:=1}"
: "${PHPSFX_ZLIB_SLIM_LIBRARY:=1}"

# redis 不启用 session serializer/hook，避免未打包 session 扩展时出现 session_* 链接符号。
: "${PHPSFX_REDIS_DISABLE_SESSION:=1}"

# macOS 新版 clang 对 oniguruma 旧版函数指针告警更严格，构建时降级该告警避免误失败。
: "${PHPSFX_ONIGURUMA_CLANG_COMPAT:=1}"
