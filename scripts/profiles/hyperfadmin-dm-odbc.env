# Compatibility profile for the former Dameng-specific asset name.
# New Linux Release builds use hyperfadmin-odbc.env and expose the same ODBC
# runtime through the standard linux-x64 and linux-a64 assets.

PROFILE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=./hyperfadmin-odbc.env
source "${PROFILE_DIR}/hyperfadmin-odbc.env"

PHPSFX_PROFILE_NAME=hyperfadmin-dm-odbc
: "${PHPSFX_ASSET_SUFFIX:=dm-odbc}"
