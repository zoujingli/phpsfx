# Linux x86_64/ARM64 runtime with Swoole coroutine PDO ODBC support.
# The runtime links to the system unixODBC driver manager; it does not bundle
# unixODBC, the Dameng client, its configuration, or credentials.

PROFILE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=./hyperfadmin-slim.env
source "${PROFILE_DIR}/hyperfadmin-slim.env"

PHPSFX_PROFILE_NAME=hyperfadmin-dm-odbc
: "${PHPSFX_ASSET_SUFFIX:=dm-odbc}"
PHPSFX_SWOOLE_ODBC=1
: "${PHPSFX_SWOOLE_ODBC_PREFIX:=/usr}"
