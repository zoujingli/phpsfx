# Linux/macOS x86_64/ARM64 runtime with standard Swoole coroutine PDO ODBC support.
# The runtime links to the system unixODBC driver manager; database vendor
# drivers, DSNs, configuration, and credentials remain deployment concerns.

PROFILE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=./hyperfadmin-slim.env
source "${PROFILE_DIR}/hyperfadmin-slim.env"

PHPSFX_PROFILE_NAME=hyperfadmin-odbc
: "${PHPSFX_ASSET_SUFFIX:=odbc}"
PHPSFX_SWOOLE_ODBC=1
if [[ -z "${PHPSFX_SWOOLE_ODBC_PREFIX:-}" && "$(uname -s)" == "Darwin" ]] && command -v brew >/dev/null 2>&1; then
  PHPSFX_SWOOLE_ODBC_PREFIX=$(brew --prefix unixodbc 2>/dev/null || true)
fi
: "${PHPSFX_SWOOLE_ODBC_PREFIX:=/usr}"
